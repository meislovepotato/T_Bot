# Copy this file to .env and fill in real values (do NOT commit .env)

BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
ALCHEMY_WS="wss://your-alchemy-ws-url"
# Example MySQL URL: mysql://user:password@127.0.0.1:3306/database
# Example Postgres URL: postgresql://user:password@host:5432/database
DATABASE_URL="mysql://root:password@127.0.0.1:3306/wallet_alert_bot"
EXPLORER_BASE="https://basescan.org/tx/"
# Optional: limit concurrent RPC fetches
MAX_CONCURRENT_FETCH=5

# Security note: rotate BOT_TOKEN if accidentally leaked and use secure secrets management for deployments
